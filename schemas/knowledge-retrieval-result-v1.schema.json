{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kiwi-Shane/knowhere/blob/main/schemas/knowledge-retrieval-result-v1.schema.json",
  "title": "Knowhere knowledge retrieval result v1",
  "description": "Source-owned contract for a Knowhere retrieval result. Results carry provenance and native locators; they do not establish source sufficiency or an RA disposition.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "result_id",
    "request_id",
    "memory_snapshot_id",
    "memory_snapshot_sha256",
    "knowhere_repository_sha",
    "retrieval_configuration_sha256",
    "source_id",
    "source_version_id",
    "section_path",
    "native_page_start",
    "native_page_end",
    "extraction_block_ids",
    "linked_table_ids",
    "linked_image_ids",
    "retrieval_reason",
    "score_components",
    "citation",
    "warnings",
    "native_source_verification_status",
    "not_source_sufficiency_decision"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "const": "knowledge-retrieval-result-v1"
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_snapshot_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "knowhere_repository_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{7,64}$"
    },
    "retrieval_configuration_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version_id": {
      "type": "string",
      "minLength": 1
    },
    "section_path": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "native_page_start": {
      "type": "integer",
      "minimum": 1
    },
    "native_page_end": {
      "type": "integer",
      "minimum": 1
    },
    "extraction_block_ids": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "linked_table_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "linked_image_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "retrieval_reason": {
      "type": "string",
      "minLength": 1
    },
    "score_components": {
      "type": "object",
      "additionalProperties": true
    },
    "citation": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "native_reference"
      ],
      "properties": {
        "native_reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "native_source_verification_status": {
      "type": "string",
      "const": "unverified"
    },
    "not_source_sufficiency_decision": {
      "type": "boolean",
      "const": true
    }
  }
}
