{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Kiwi-Shane/knowhere/blob/main/schemas/page-retrieval-result-v1.schema.json",
  "title": "Knowhere page retrieval result v1",
  "description": "Unverified, evidence-lead-only page navigation result with a native page locator.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "request_id",
    "result_id",
    "memory_snapshot_id",
    "source_id",
    "source_version_id",
    "page_id",
    "page_number",
    "native_page_locator",
    "match_modes",
    "score_components",
    "rank",
    "reason_codes",
    "warnings",
    "verification_status",
    "evidence_status",
    "not_verified_absence"
  ],
  "properties": {
    "contract_version": {
      "const": "page-retrieval-result-v1"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "result_id": {
      "type": "string",
      "minLength": 1
    },
    "memory_snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "source_id": {
      "type": "string",
      "minLength": 1
    },
    "source_version_id": {
      "type": "string",
      "minLength": 1
    },
    "page_id": {
      "type": "string",
      "pattern": "^page-[0-9a-f]{64}$"
    },
    "page_number": {
      "type": "integer",
      "minimum": 1
    },
    "native_page_locator": {
      "type": "string",
      "pattern": "^.+:p[1-9][0-9]*$"
    },
    "match_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": ["lexical", "visual", "hybrid", "section_proximity", "adjacent_page"]
      }
    },
    "score_components": {
      "type": "object",
      "additionalProperties": {
        "type": "number"
      }
    },
    "rank": {
      "type": "integer",
      "minimum": 1
    },
    "reason_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "verification_status": {
      "const": "unverified"
    },
    "evidence_status": {
      "const": "evidence_lead_only"
    },
    "not_verified_absence": {
      "const": true
    }
  }
}
